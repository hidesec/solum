{
  "name": "solumjs",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev": "npm run dev --workspace backend-example",
    "migrate": "npm run migrate --workspace backend-example",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "solum": "npx solum",
    "size": "node scripts/size-report.js"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12"
  }
}
