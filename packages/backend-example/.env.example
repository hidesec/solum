# ===== Application =====
NODE_ENV=development
PORT=3000

# ===== Security =====
# Required. Use a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=secret-key

# Max requests per 15 minutes per IP (default: 100)
RATE_LIMIT_MAX=100

# Allowed CORS origin (framework default: *)
CORS_ORIGIN=http://localhost:3000

# CSRF protection (set to 'true' to enable)
# CSRF_ENABLED=true
# CSRF_SECRET=change-me-to-a-long-random-string

# ===== Database (relational) =====
# Options: postgres | mysql | mssql | oracle | sqlite
DB_CLIENT=postgres

# Required unless DB_CLIENT=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solumjs_app
DB_USER=postgres
DB_PASSWORD=change-me

# Only used when DB_CLIENT=sqlite (default: ./data/app.db)
# DB_FILE=./data/app.db

# Default port per client when DB_PORT is empty:
#   postgres=5432, mysql=3306, mssql=1433, oracle=1521

# ===== Connection Pool (optional) =====
# DB_POOL_MIN=0
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT=30000
# DB_POOL_CONNECT_TIMEOUT=5000

# ===== MongoDB (optional) =====
# MONGO_URL=mongodb://localhost:27017/solumjs_app

# ===== Redis (optional) =====
# REDIS_URL=redis://localhost:6379
