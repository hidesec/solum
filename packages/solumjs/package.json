  "dependencies": {
    "@solumjs/core": "^0.2.1",
    "@solumjs/http": "^0.2.1",
    "@solumjs/aop": "^0.2.1",
    "@solumjs/orm": "^0.2.1",
    "@solumjs/database": "^0.2.1",
    "@solumjs/cache": "^0.2.1",
    "@solumjs/auth": "^0.2.1",
    "@solumjs/events": "^0.2.1",
    "@solumjs/schedule": "^0.2.1",
    "@solumjs/config": "^0.2.1",
    "@solumjs/validation": "^0.2.1",
    "@solumjs/middlewares": "^0.2.1",
    "@solumjs/testing": "^0.2.1",
    "@solumjs/websocket": "^0.2.1",
    "@solumjs/email": "^0.2.1",
    "@solumjs/cli": "^0.1.4"
  },
  "keywords": [
